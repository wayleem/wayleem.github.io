---
// Card grid, shared by /products. The home page composes its own so it can mix
// eager/lazy loading across the fold.
import Card from '@/components/Card.astro';
import { getCollection } from 'astro:content';
import { coverFor } from '@/lib/site';

const items = (await getCollection('products'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => a.data.order - b.data.order || +b.data.date - +a.data.date);
---

<div class="grid">
  {items.map((e, i) => (
    <Card
      href={`/products/${e.id}`}
      cover={coverFor(e.id, e.data.cover, true)}
      title={e.data.title}
      label={e.data.kind === 'tool' ? 'Tool' : 'Product'}
      summary={e.data.tagline ?? e.data.summary}
      eager={i < 3}
    />
  ))}
</div>
