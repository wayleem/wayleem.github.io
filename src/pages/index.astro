---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NowStrip from '@/components/NowStrip.astro';
import ProductList from '@/components/ProductList.astro';
import FeedItem from '@/components/FeedItem.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@/lib/site';

const FEED_LIMIT = 15;

const posts = (await getCollection('posts'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, FEED_LIMIT);
---

<BaseLayout title={SITE.name} rawTitle description={SITE.description}>
  <NowStrip />

  <ul class="feed">
    {posts.map((e) => (
      <li>
        <FeedItem
          slug={e.id}
          title={e.data.title}
          summary={e.data.summary}
          date={e.data.date}
          kind={e.data.kind}
          project={e.data.project}
        />
      </li>
    ))}
  </ul>

  <div class="section-head">
    <h2>Products</h2>
    <a href="/products">All →</a>
  </div>
  <ProductList />
</BaseLayout>
