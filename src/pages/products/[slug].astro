---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { fmtDate, itemLabel, yearOf, shareImageFor } from '@/lib/site';

export async function getStaticPaths() {
  const items = (await getCollection('products')).filter((e) => !e.data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Ship log for this product, newest first — the case study explains the
// thinking, the log shows it's still moving.
const log = (await getCollection('posts'))
  .filter((e) => !e.data.draft && e.data.project === entry.id)
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 8);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  ogImage={shareImageFor(entry.id, true)}
>
  <article class="article">
    <h1 class="article__title">{entry.data.title}</h1>
    <p class="article__lede">{entry.data.tagline ?? entry.data.summary}</p>

    <p class="item__meta" style="margin-top: 1rem">
      {entry.data.url && (
        <a class="meta" href={entry.data.url} target="_blank" rel="noopener">
          {new URL(entry.data.url).host} ↗
        </a>
      )}
      {entry.data.repo && (
        <a class="meta" href={entry.data.repo} target="_blank" rel="noopener">Source ↗</a>
      )}
      <span class="meta">Since {yearOf(entry.data.date)}</span>
    </p>

    {entry.data.stack.length > 0 && (
      <div class="product__stack" style="margin-top: 0.75rem">
        {entry.data.stack.map((s) => <span>{s}</span>)}
      </div>
    )}

    {entry.data.cover && <img class="cover" src={entry.data.cover} alt="" style="width:100%;margin:2rem 0;border-radius:var(--radius);border:1px solid var(--border)" />}

    <div class="prose" style="margin-top: 2rem"><Content /></div>

    {log.length > 0 && (
      <>
        <div class="section-head">
          <h2>Ship log</h2>
          <a href="/blog">All →</a>
        </div>
        <ul class="feed">
          {log.map((e) => (
            <li>
              <a class="item item--log" href={`/blog/${e.id}`}>
                <div class="item__meta">
                  <time class="meta" datetime={e.data.date.toISOString()}>{fmtDate(e.data.date)}</time>
                  <span class="meta">{itemLabel(e.data.kind, e.data.project)}</span>
                </div>
                <h3 class="item__title">{e.data.title}</h3>
                <p class="item__summary">{e.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}

    <div class="article__foot">
      <a class="meta" href="/products">← All products</a>
    </div>
  </article>
</BaseLayout>
