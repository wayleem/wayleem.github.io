---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { EXPERIENCE } from '@/lib/site';
---

<BaseLayout title="About" description="William Huang — fullstack engineer. What I build and where I've worked.">
  <article class="article">
    <h1 class="article__title">About</h1>

    <div class="prose">
      <p>
        I'm William Huang. I'm a fullstack engineer. I build web products — currently
        <a href="/products/skadooble">skadooble</a>, an AI study tool, and
        <a href="/products/flowviant">flowviant</a>, a workbench for running coding agents
        across machines. I also trade my own money.
      </p>
      <p>
        Most of what I write here comes out of that work: decisions I had to make, things
        that broke in production, and the occasional opinion about how software should be
        put together.
      </p>
    </div>

    {EXPERIENCE.length > 0 && (
    <div class="section-head">
      <h2>Experience</h2>
    </div>
    <ul class="roles">
      {EXPERIENCE.map((r) => (
        <li>
          <div class="role__head">
            <span class="role__title">{r.title}</span>
            <span class="role__org">{r.org}</span>
            <span class="meta" style="margin-left:auto">{r.period}</span>
          </div>
          <p class="role__summary">{r.summary}</p>
        </li>
      ))}
    </ul>
    )}

  </article>
</BaseLayout>
